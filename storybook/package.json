{
  "name": "native-one-file-pilot-storybook",
  "private": true,
  "version": "0.1.0",
  "description": "Living documentation for the Native One File Pilot Design System (Mobile Adaptive: iOS + Android in one Figma file). Documentation only, not production code.",
  "type": "module",
  "scripts": {
    "tokens": "cd ../../.. && python tools/tokens_to_css.py \"My Projects/Native_One_File_Pilot\"",
    "docs": "cd ../../.. && python tools/storybook_docs.py \"My Projects/Native_One_File_Pilot\"",
    "stories": "cd ../../.. && python tools/storybook_stories.py \"My Projects/Native_One_File_Pilot\"",
    "parity": "cd ../../.. && python tools/storybook_parity.py \"My Projects/Native_One_File_Pilot\"",
    "storybook": "storybook dev -p 6008",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-designs": "11.1.4",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-mcp": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "10.6.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  }
}
